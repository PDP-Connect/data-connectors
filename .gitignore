# Misc
*.log
.DS_Store
.fetch-cache.json
.env
node_modules/
dist/

# Test runner output
connector-result.json
test-results/

# Non-connector projects (stray checkouts)
clearcut/
proxy-test/

# Vendored playwright-runner's own install
playwright-runner/node_modules/

# Connector fixtures (moved from packages/polyfill-connectors/fixtures/ at the
# hard cutover; see docs/migration/connector-cutover/CONTRACTS.md). Raw
# captures hold UNSCRUBBED provider data — real names, emails, message
# bodies. PDPP_CAPTURE_FIXTURES=1 writes them here during a real run, and a
# DOM-capture connector leaks names by default (a bare name in an HTML text
# node matches no structured field, so the deterministic scrubber cannot see
# it). Only the SCRUBBED output is committable. Ignore raw at every depth so a
# capture can never reach a commit by accident.
connectors/*/fixtures/**/raw/
connectors/*/fixtures/fixture_capture*/

# claude_code and codex commit fully-synthetic local-collector source-home
# fixtures; un-ignore them so realistic fixture filenames like debug.log
# (otherwise swallowed by this file's *.log rule) stay committable.
!connectors/claude_code/fixtures/source-home/**
!connectors/codex/fixtures/source-home/**
