name = "connector-catalog-websub-publisher"
main = "dist/worker.mjs"
compatibility_date = "2026-07-30"
workers_dev = false
# Configure a custom domain/route for TOPIC_URL's origin before deploying.
[build]
command = "npm run build"
[vars]
TOPIC_URL = "https://publisher.example/topic"
HUB_URL = "https://hub.example/"
OIDC_AUDIENCE = "SET_AUDIENCE"
[[durable_objects.bindings]]
name = "PUBLISHER"
class_name = "PublisherState"
[[migrations]]
tag = "v1"
new_sqlite_classes = ["PublisherState"]
