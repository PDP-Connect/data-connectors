{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PDP-Connect/data-connectors/schemas/connector-index.schema.json",
  "title": "Connector Index v2",
  "type": "object",
  "required": [
    "indexVersion",
    "sourceRepo",
    "generatedAt",
    "connectors"
  ],
  "properties": {
    "indexVersion": {
      "const": "2.0"
    },
    "sourceRepo": {
      "type": "string",
      "format": "uri"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "signature": {
      "anyOf": [
        {
          "$ref": "#/$defs/signature"
        },
        {
          "type": "null"
        }
      ]
    },
    "connectors": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/indexEntry"
        }
      }
    }
  },
  "$defs": {
    "sourceFiles": {
      "type": "object",
      "required": [
        "script",
        "metadata"
      ],
      "additionalProperties": false,
      "properties": {
        "script": {
          "type": "string"
        },
        "metadata": {
          "type": "string"
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "bundlePath"
      ],
      "properties": {
        "type": {
          "const": "sigstoreBundle"
        },
        "bundlePath": {
          "type": "string"
        },
        "bundleUrl": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "indexEntry": {
      "type": "object",
      "required": [
        "connectorId",
        "company",
        "version",
        "name",
        "description",
        "publishedAt",
        "releaseId",
        "manifestSha256",
        "artifactSha256",
        "artifactUrl"
      ],
      "additionalProperties": true,
      "oneOf": [
        {
          "description": "Legacy connector artifacts omit artifactKind and retain the manifest.json plus script.js contract.",
          "allOf": [
            {
              "not": {
                "required": ["artifactKind"]
              }
            },
            {
              "required": ["sourceFiles", "scriptSha256"]
            },
            {
              "oneOf": [
                {
                  "required": ["sourceTag", "sourceCommit"]
                },
                {
                  "required": ["gitRef"]
                }
              ]
            }
          ]
        },
        {
          "description": "PDPP Collection Profile artifacts declare their canonical manifest and packaged executable entrypoint.",
          "required": [
            "artifactKind",
            "manifestPath",
            "entrypointPath",
            "entrypointSha256",
            "sourceTag",
            "sourceCommit"
          ],
          "properties": {
            "artifactKind": {
              "const": "pdpp-collection-profile"
            },
            "manifestPath": {
              "$ref": "#/$defs/bundlePath"
            },
            "entrypointPath": {
              "$ref": "#/$defs/bundlePath"
            },
            "entrypointSha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        }
      ],
      "properties": {
        "connectorId": {
          "type": "string"
        },
        "company": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "sourceFiles": {
          "$ref": "#/$defs/sourceFiles"
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time"
        },
        "sourceTag": {
          "type": "string"
        },
        "sourceCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "gitRef": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "releaseId": {
          "type": "string"
        },
        "manifestSha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "scriptSha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "artifactKind": {
          "type": "string"
        },
        "manifestPath": {
          "$ref": "#/$defs/bundlePath"
        },
        "entrypointPath": {
          "$ref": "#/$defs/bundlePath"
        },
        "entrypointSha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "artifactSha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "artifactPath": {
          "type": "string"
        },
        "artifactUrl": {
          "type": "string",
          "format": "uri"
        },
        "artifactSignature": {
          "anyOf": [
            {
              "$ref": "#/$defs/signature"
            },
            {
              "type": "null"
            }
          ]
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "consumerMetadata": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "bundlePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\.$)(?!.*\\u0000)(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    }
  }
}
