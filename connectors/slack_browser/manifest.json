						"has_files",
						"is_thread_parent",
						"is_tombstone"
					],
					"group_by_time": ["sent_at"]
				},
				"expand": [
					{
						"name": "message_attachments",
						"default_limit": 10,
						"max_limit": 50
					},
					{
						"name": "reactions",
						"default_limit": 25,
						"max_limit": 200
					}
				]
			},
			"coverage_strategy": "checkpoint_window",
			"freshness_strategy": "scheduled_window",
			"required": false
		},
