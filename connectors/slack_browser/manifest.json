			"primary_key": ["id"],
			"cursor_field": "sent_at",
			"consent_time_field": "sent_at",
			"selection": {
				"fields": true,
				"resources": true
			},
			"incremental": true,
			"relationships": [
				{
					"name": "channel",
					"stream": "channels",
					"foreign_key": "channel_id",
					"cardinality": "has_one"
				},
				{
					"name": "author",
					"stream": "users",
					"foreign_key": "user_id",
					"cardinality": "has_one"
				},
				{
					"name": "message_attachments",
					"stream": "message_attachments",
					"foreign_key": "message_id",
					"cardinality": "has_many"
				},
				{
					"name": "reactions",
					"stream": "reactions",
					"foreign_key": "message_id",
					"cardinality": "has_many"
				}
			],
			"query": {
				"search": {
					"lexical_fields": ["text", "subtype", "metadata_event_type"],
					"semantic_fields": ["text"]
				},
				"range_filters": {
					"sent_at": ["gte", "gt", "lte", "lt"],
					"reply_count": ["gte", "gt", "lte", "lt"],
					"file_count": ["gte", "gt", "lte", "lt"],
					"attachment_count": ["gte", "gt", "lte", "lt"],
					"reaction_count": ["gte", "gt", "lte", "lt"]
				},
				"aggregations": {
					"count": true,
					"sum": [
						"reply_count",
						"file_count",
						"attachment_count",
						"reaction_count"
					],
					"min": [
						"sent_at",
						"reply_count",
						"file_count",
						"attachment_count",
						"reaction_count"
					],
					"max": [
						"sent_at",
						"reply_count",
						"file_count",
						"attachment_count",
						"reaction_count"
					],
					"group_by": [
