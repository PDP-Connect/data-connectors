{
	"protocol_version": "0.1.0",
	"connector_id": "https://registry.pdpp.dev/connectors/slack-browser",
	"source": {
		"id": "https://registry.pdpp.dev/sources/slack",
		"display": {
			"name": "Slack"
		}
	},
	"connector_key": "slack-browser",
	"manifest_uri": "https://registry.pdpp.dev/connectors/slack-browser",
	"version": "0.1.0",
	"display_name": "Slack (Browser Sign-In)",
	"brand": {
		"icon": "icon.svg",
		"background_color": "#4A154B"
	},
	"runtime_requirements": {
		"bindings": {
			"network": {
				"required": true
			},
			"browser": {
				"required": true
			}
		},
		"environment_variables": [
			"SLACK_WORKSPACE",
			"SLACK_LOOKBACK_DAYS",
			"SLACK_CHANNEL_TYPES",
			"SLACK_CHANNEL_ALLOWLIST"
		]
	},
	"capabilities": {
		"human_interaction": ["manual_action"],
		"refresh_policy": {
			"recommended_mode": "manual",
			"recommended_interval_seconds": 86400,
			"minimum_interval_seconds": 3600,
			"maximum_staleness_seconds": 604800,
			"interaction_posture": "manual_action_likely",
			"rate_limit_sensitivity": "medium",
			"bot_detection_sensitivity": "medium",
			"background_safe": false,
			"rationale": "Collection calls the Slack Web API from the owner's own signed-in app.slack.com session, the way the web client does. A live session refreshes without a prompt; the first run and an expired session need the owner to sign in through the browser handoff. Calls are paced and retried on Slack's rate-limit answers, and a run reads at most the lookback window per conversation."
		},
		"public_listing": {
			"tier": "development"
		}
	},
	"streams": [
		{
			"name": "workspace",
			"required": true,
			"description": "The Slack workspace this browser session is signed in to: team identity, the signed-in user, enterprise affiliation, primary URL.",
			"compaction_fingerprint": {
				"exclude_keys": ["fetched_at"]
			},
			"display": {
				"label": "Slack workspace",
				"detail": "Workspace name, domain, team ID, the signed-in user (whose session this is), and enterprise parent (if any)."
			},
			"semantics": "mutable_state",
			"schema": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"name": {
						"type": ["string", "null"],
						"x_pdpp_role": "primary-title"
					},
					"domain": {
						"type": ["string", "null"]
					},
					"email_domain": {
						"type": ["string", "null"]
					},
					"enterprise_id": {
						"type": ["string", "null"]
					},
					"enterprise_name": {
						"type": ["string", "null"]
					},
					"url": {
						"type": ["string", "null"]
					},
					"icon_url": {
						"type": ["string", "null"]
					},
					"authenticated_user_id": {
						"type": ["string", "null"]
					},
					"authenticated_username": {
						"type": ["string", "null"]
					},
					"authenticated_bot_id": {
						"type": ["string", "null"]
					},
					"fetched_at": {
						"type": "string",
						"format": "date-time",
						"x_pdpp_role": "event-time"
					}
				},
				"required": ["id"]
			},
			"primary_key": ["id"],
			"cursor_field": "fetched_at",
			"selection": {
				"fields": true,
				"resources": true
			},
			"incremental": true,
			"query": {
				"search": {
					"lexical_fields": ["name", "domain", "enterprise_name", "url"]
				},
				"aggregations": {
					"count": true,
					"group_by_time": ["fetched_at"]
				}
			},
			"coverage_strategy": "singleton_presence",
			"freshness_strategy": "scheduled_window"
		},
		{
			"name": "channels",
