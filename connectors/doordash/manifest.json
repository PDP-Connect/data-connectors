{
	"protocol_version": "0.1.0",
	"connector_id": "https://registry.pdpp.dev/connectors/doordash",
	"connector_key": "doordash",
	"manifest_uri": "https://registry.pdpp.dev/connectors/doordash",
	"version": "0.2.4",
	"display_name": "DoorDash",
	"brand": {
		"icon": "icon.svg",
		"background_color": "#FF3008"
	},
	"runtime_requirements": {
		"bindings": {
			"network": {
				"required": true
			},
			"browser": {
				"required": true
			}
		}
	},
	"setup": {
		"modality": "static_secret",
		"credential_capture": {
			"kind": "username_password",
			"label": "DoorDash sign-in details",
			"description": "Seal the DoorDash sign-in details for this source. The connector uses them only for this source's browser-backed collection.",
			"submit_label": "Save DoorDash credential and start first sync",
			"fields": [
				{
					"name": "username",
					"label": "DoorDash email",
					"type": "text",
					"required": true,
					"secret": true,
					"autocomplete": "username",
					"env": ["DOORDASH_USERNAME"]
				},
				{
					"name": "password",
					"label": "DoorDash password",
					"type": "password",
					"required": true,
					"secret": true,
					"autocomplete": "current-password",
					"env": ["DOORDASH_PASSWORD"]
				}
			]
		}
	},
	"capabilities": {
		"human_interaction": ["manual_action", "otp"],
		"refresh_policy": {
			"recommended_mode": "manual",
			"minimum_interval_seconds": 3600,
			"interaction_posture": "manual_action_likely",
			"rate_limit_sensitivity": "medium",
			"bot_detection_sensitivity": "high",
			"background_safe": false,
			"rationale": "DoorDash order history is browser-scraped behind Cloudflare bot protection; treat as manual to avoid bot-detection signals. No incremental cursor is implemented (see connectors/doordash/index.ts) — every run performs a full refresh of the order list, so more frequent scheduling buys nothing without also increasing bot-detection exposure."
		},
		"public_listing": {
			"tier": "development"
		}
	},
	"streams": [
		{
			"name": "orders",
			"required": true,
			"description": "DoorDash food-delivery orders.",
			"display": {
				"label": "Your DoorDash orders",
				"detail": "Order date, restaurant, items, prices, tips, tax, delivery status, delivery address, fee breakdown."
			},
			"semantics": "mutable_state",
			"schema": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"order_date": {
						"type": ["string", "null"],
						"format": "date-time",
						"x_pdpp_role": "event-time"
					},
					"restaurant_name": {
						"type": ["string", "null"]
					},
					"status": {
						"type": ["string", "null"]
					},
					"subtotal_cents": {
						"type": ["integer", "null"]
					},
					"tax_cents": {
						"type": ["integer", "null"]
					},
					"tip_cents": {
						"type": ["integer", "null"]
					},
					"delivery_fee_cents": {
						"type": ["integer", "null"]
					},
					"service_fee_cents": {
						"type": ["integer", "null"]
					},
					"total_cents": {
						"type": ["integer", "null"]
					},
					"delivery_address": {
						"type": ["string", "null"]
					},
					"payment_method_summary": {
						"type": ["string", "null"],
						"x_pdpp_role": "secondary"
					},
					"item_count": {
						"type": ["integer", "null"]
					}
				},
				"required": ["id"]
			},
			"primary_key": ["id"],
			"consent_time_field": "order_date",
			"selection": {
				"fields": true,
				"resources": true
			},
			"incremental": false,
			"query": {
				"search": {
					"lexical_fields": ["restaurant_name"]
				},
				"range_filters": {
					"order_date": ["gte", "gt", "lte", "lt"]
				},
				"aggregations": {
					"count": true,
					"group_by_time": ["order_date"],
					"group_by": ["status"]
				}
			},
			"coverage_strategy": "full_inventory",
			"freshness_strategy": "manual_as_of"
		},
		{
			"name": "order_items",
			"required": false,
			"description": "Individual items within DoorDash orders.",
			"display": {
				"label": "Your DoorDash order items",
				"detail": "Item name, quantity, unit price, customizations."
			},
			"semantics": "mutable_state",
			"schema": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"order_id": {
						"type": "string"
					},
					"name": {
						"type": "string",
						"x_pdpp_role": "primary-title"
					},
					"quantity": {
						"type": "integer"
					},
					"unit_price_cents": {
						"type": ["integer", "null"]
					},
					"customizations": {
						"type": "array"
					}
				},
				"required": ["id", "order_id", "name"]
			},
			"primary_key": ["id"],
			"selection": {
				"fields": true,
				"resources": true
			},
			"incremental": false,
			"relationships": [
				{
					"name": "order",
					"stream": "orders",
					"foreign_key": "order_id",
					"cardinality": "has_one"
				}
			],
			"query": {
				"search": {
					"lexical_fields": ["name"]
				}
			},
			"coverage_strategy": "full_inventory",
			"freshness_strategy": "manual_as_of"
		}
	],
	"reason_display_messages": {
		"doordash_orders_response_not_observed": "We couldn't read your DoorDash order history this time. This can mean your account has no orders yet, or that DoorDash changed something on their end — we'll try again on the next scheduled run.",
		"older_pages_deferred_page_budget": "We stopped after reading a set number of pages of your DoorDash order history, so older orders haven't been collected yet. Nothing was lost — the next run picks up more history.",
		"shape_check_failed": "The data didn't look like we expected"
	}
}
