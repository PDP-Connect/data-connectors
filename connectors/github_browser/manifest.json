{
	"protocol_version": "0.1.0",
	"connector_id": "https://registry.pdpp.dev/connectors/github-browser",
	"source": {
		"id": "https://registry.pdpp.dev/sources/github",
		"display": {
			"name": "GitHub"
		}
	},
	"connector_key": "github-browser",
	"manifest_uri": "https://registry.pdpp.dev/connectors/github-browser",
	"version": "0.3.0",
	"display_name": "GitHub (browser session)",
	"brand": {
		"icon": "icon.svg",
		"background_color": "#181717"
	},
	"runtime_requirements": {
		"bindings": {
			"network": {
				"required": true,
				"features": ["host_http_request"]
			},
			"browser": {
				"required": true,
				"features": [
					"page_script_evaluation",
					"page_navigation",
					"page_content_read",
					"page_condition_wait",
					"host_http_request"
				]
			}
		}
	},
	"capabilities": {
		"human_interaction": ["manual_action"],
		"public_listing": {
			"tier": "development",
			"rationale": "Separate browser-session profile for existing Vana GitHub users. The PAT connector remains the recommended profile for new connections."
		},
		"refresh_policy": {
			"recommended_mode": "manual",
			"recommended_interval_seconds": 21600,
			"minimum_interval_seconds": 3600,
			"maximum_staleness_seconds": 86400,
			"interaction_posture": "manual_action_likely",
			"rate_limit_sensitivity": "high",
			"bot_detection_sensitivity": "medium",
			"background_safe": false,
			"rationale": "Uses an owner signed-in GitHub browser session and public GitHub web/API surfaces. Expired sessions need owner sign-in."
		}
	},
	"streams": [
		{
			"name": "profile",
			"required": true,
			"description": "Legacy GitHub profile, pinned repositories, organization links, achievements, and displayed contribution count, collected from the signed-in profile page.",
			"semantics": "mutable_state",
			"schema": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"username": {
						"type": "string",
						"x_pdpp_role": "primary-title"
					},
					"fullName": {
						"type": "string"
					},
					"bio": {
						"type": "string"
					},
					"company": {
						"type": "string"
					},
					"location": {
						"type": "string"
					},
					"website": {
						"type": "string"
					},
					"avatarUrl": {
						"type": "string"
					},
					"followers": {
						"type": "number"
					},
					"following": {
						"type": "number"
					},
					"repositoryCount": {
						"type": "number"
					},
					"profileUrl": {
						"type": "string"
					},
					"pinnedRepositories": {
						"type": "array",
						"items": {
							"type": "object",
							"properties": {
								"fullName": {
									"type": "string"
								},
								"url": {
									"type": ["string", "null"]
								},
								"description": {
									"type": "string"
								},
								"language": {
									"type": ["string", "null"]
								},
								"stars": {
									"type": "number"
								}
							},
							"required": ["fullName"],
							"additionalProperties": false
						}
					},
					"organizations": {
						"type": "array",
						"items": {
							"type": "object",
							"properties": {
								"login": {
									"type": "string"
								},
								"label": {
									"type": "string"
								},
								"url": {
									"type": "string"
								},
								"avatarUrl": {
									"type": ["string", "null"]
								}
							},
							"required": ["login"],
							"additionalProperties": false
						}
					},
					"achievements": {
						"type": "array",
						"items": {
							"type": "object",
							"properties": {
								"name": {
									"type": "string"
								},
								"iconUrl": {
									"type": ["string", "null"]
								}
							},
							"required": ["name"],
							"additionalProperties": false
						}
					},
					"contributionsLastYear": {
						"type": ["number", "null"]
					}
				},
				"required": ["id", "username", "profileUrl"],
				"additionalProperties": false
			},
			"primary_key": ["id"],
			"selection": {
				"fields": true,
				"resources": true
			},
			"incremental": false,
			"query": {
				"search": {
					"lexical_fields": ["username", "bio", "company", "location"],
					"semantic_fields": ["bio"]
				}
			},
			"coverage_strategy": "singleton_presence",
			"freshness_strategy": "scheduled_window"
		},
		{
			"name": "repositories",
			"required": true,
			"description": "One user-owned repository row from the signed-in user’s repository inventory. Stable row IDs allow valid pages to ingest before the inventory reaches a proven end.",
			"semantics": "mutable_state",
			"schema": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"name": {
						"type": "string"
					},
					"url": {
						"type": "string"
					},
					"description": {
						"type": "string"
					},
					"language": {
						"type": "string"
					},
					"stars": {
						"type": "number"
					},
					"forks": {
						"type": "number"
					},
					"visibility": {
						"type": "string"
					},
					"topics": {
						"type": "array",
						"items": {
							"type": "string"
						}
					},
					"updatedAt": {
						"type": ["string", "null"]
					}
				},
				"required": ["id", "name", "url"],
				"additionalProperties": false
			},
			"primary_key": ["id"],
			"selection": {
				"fields": true,
				"resources": true
			},
			"incremental": false,
			"coverage_strategy": "full_inventory",
			"freshness_strategy": "scheduled_window"
		},
		{
			"name": "starred",
			"required": true,
			"description": "One starred repository row from the signed-in user’s starred inventory. Stable row IDs allow valid pages to ingest before the inventory reaches a proven end.",
			"semantics": "mutable_state",
			"schema": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"fullName": {
						"type": "string"
					},
					"url": {
						"type": "string"
					},
					"description": {
						"type": "string"
					},
					"language": {
						"type": "string"
					},
					"stars": {
						"type": "number"
					},
					"updatedAt": {
						"type": ["string", "null"]
					}
				},
				"required": ["fullName", "id", "url"],
				"additionalProperties": false
			},
			"primary_key": ["id"],
			"selection": {
				"fields": true,
				"resources": true
			},
			"incremental": false,
			"coverage_strategy": "full_inventory",
			"freshness_strategy": "scheduled_window"
		},
		{
			"name": "events",
			"required": true,
			"description": "One public event row in GitHub’s retained public-event window. Three full 100-row pages prove the declared 300-event window; this is not lifetime history.",
			"semantics": "mutable_state",
			"schema": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"type": {
						"type": "string"
					},
					"createdAt": {
						"type": "string"
					},
					"repo": {
						"type": "string"
					},
					"repoUrl": {
						"type": "string"
					},
					"action": {
						"type": ["string", "null"]
					},
					"title": {
						"type": ["string", "null"]
					},
					"body": {
						"type": ["string", "null"]
					},
					"url": {
						"type": ["string", "null"]
					},
					"branch": {
						"type": ["string", "null"]
					},
					"commits": {
						"type": ["number", "null"]
					},
					"isPublic": {
						"type": "boolean"
					}
				},
				"required": ["id", "type", "createdAt", "repo", "isPublic"],
				"additionalProperties": false
			},
			"primary_key": ["id"],
			"selection": {
				"fields": true,
				"resources": true
			},
			"incremental": false,
			"coverage_strategy": "full_inventory",
			"freshness_strategy": "scheduled_window"
		},
		{
			"name": "contributions",
			"required": true,
			"description": "Contribution day rows plus one summary row from the rolling year and three prior calendar-year views. The summary is emitted only when every date in all four views is covered.",
			"semantics": "mutable_state",
			"schema": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					}
				},
				"oneOf": [
					{
						"type": "object",
						"properties": {
							"recordType": {
								"const": "day",
								"type": "string"
							},
							"id": {
								"type": "string"
							},
							"date": {
								"type": "string"
							},
							"count": {
								"type": "number"
							},
							"level": {
								"type": ["number", "null"]
							}
						},
						"required": ["recordType", "id", "date", "count", "level"],
						"additionalProperties": false
					},
					{
						"type": "object",
						"properties": {
							"recordType": {
								"const": "summary",
								"type": "string"
							},
							"id": {
								"type": "string"
							},
							"username": {
								"type": "string"
							},
							"fetchedAt": {
								"type": "string"
							},
							"totalContributionsLastYear": {
								"type": "number"
							},
							"yearTotals": {
								"type": "array",
								"items": {
									"type": "object",
									"properties": {
										"year": {
											"type": "number"
										},
										"total": {
											"type": "number"
										}
									},
									"required": ["year", "total"],
									"additionalProperties": false
								}
							},
							"monthlyTotals": {
								"type": "array",
								"items": {
									"type": "object",
									"properties": {
										"month": {
											"type": "string"
										},
										"count": {
											"type": "number"
										}
									},
									"required": ["month", "count"],
									"additionalProperties": false
								}
							},
							"topDay": {
								"type": ["object", "null"],
								"properties": {
									"date": {
										"type": "string"
									},
									"count": {
										"type": "number"
									}
								},
								"required": ["date", "count"],
								"additionalProperties": false
							}
						},
						"required": [
							"recordType",
							"id",
							"username",
							"fetchedAt",
							"totalContributionsLastYear",
							"yearTotals",
							"monthlyTotals",
							"topDay"
						],
						"additionalProperties": false
					}
				]
			},
			"primary_key": ["id"],
			"selection": {
				"fields": true,
				"resources": true
			},
			"incremental": false,
			"coverage_strategy": "full_inventory",
			"freshness_strategy": "scheduled_window"
		},
		{
			"name": "history",
			"required": true,
			"description": "One authored issue or pull request row from GitHub Search. Each type has a 1,000-result window. Larger result sets retain the newest window as partial data and do not advance completion.",
			"semantics": "mutable_state",
			"schema": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"type": {
						"type": "string"
					},
					"number": {
						"type": ["number", "null"]
					},
					"title": {
						"type": ["string", "null"]
					},
					"body": {
						"type": ["string", "null"]
					},
					"state": {
						"type": ["string", "null"]
					},
					"createdAt": {
						"type": ["string", "null"]
					},
					"updatedAt": {
						"type": ["string", "null"]
					},
					"closedAt": {
						"type": ["string", "null"]
					},
					"mergedAt": {
						"type": ["string", "null"]
					},
					"url": {
						"type": ["string", "null"]
					},
					"repo": {
						"type": "string"
					},
					"repoUrl": {
						"type": ["string", "null"]
					},
					"labels": {
						"type": "array",
						"items": {
							"type": "string"
						}
					},
					"comments": {
						"type": "number"
					},
					"reactionsTotal": {
						"type": "number"
					},
					"isDraft": {
						"type": "boolean"
					}
				},
				"required": ["id", "type", "repo"],
				"additionalProperties": false
			},
			"primary_key": ["id"],
			"selection": {
				"fields": true,
				"resources": true
			},
			"incremental": false,
			"coverage_strategy": "full_inventory",
			"freshness_strategy": "scheduled_window"
		}
	],
	"profiles": [
		{
			"id": "legacy",
			"label": "Legacy GitHub browser collection",
			"streams": [
				{
					"name": "profile"
				},
				{
					"name": "repositories"
				},
				{
					"name": "starred"
				},
				{
					"name": "events"
				},
				{
					"name": "contributions"
				},
				{
					"name": "history"
				}
			]
		}
	],
	"reason_display_messages": {
		"github_browser_incomplete": "GitHub did not return a complete result for this stream."
	},
	"mobile": {
		"pageshim": {
			"entry": "github_browser.ts",
			"exception": "Preserves the app's existing GitHub envelope and summary shape.",
			"scope_prefix": "github",
			"login_url": "https://github.com/login"
		}
	}
}
