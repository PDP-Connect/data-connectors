# Credentials for local connector runs. Copy to .env.local at the repository
# root (packages/polyfill-connectors/bin/connector-dev.ts reads that file).
# Each connector's manifest.json names the variables it reads in the "env"
# field of its credential inputs. Values stay on this machine.

# REDDIT_USERNAME=your_username
# REDDIT_PASSWORD=your_password

# USAA_USERNAME=your_username
# USAA_PASSWORD=your_password
