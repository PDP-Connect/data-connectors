{
  "compilerOptions": {
    // Language + module (Node ESM)
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "moduleDetection": "force",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "forceConsistentCasingInFileNames": true,

    // Strictness: the 2026 "strict-plus" baseline. Every flag here catches
    // a class of bug that 'strict: true' alone does not.
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    // noPropertyAccessFromIndexSignature forces process.env['X'] bracket
    // access, which Biome's useLiteralKeys rejects. Leaving off —
    // Biome's stance (prefer dot-access) matches mainstream style.
    "noPropertyAccessFromIndexSignature": false,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "useUnknownInCatchVariables": true,

    // Dev ergonomics — no emit, type-check only. Bundling (if ever
    // published) happens via a separate build step.
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],

    // We run .ts directly via tsx; no emitted .js to import. Biome's
    // useImportExtensions enforces explicit .ts extensions on local
    // imports, and tsx/Node strip them at load time. This matches
    // Playwright/Stripe/Vercel/vitest's convention for source-only
    // TypeScript packages.
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/**/*.ts",
    "connectors/**/*.ts",
    "bin/**/*.ts",
    "bench/**/*.ts",
    "types/**/*.d.ts"
  ],
  // __fixtures__/ holds hand-crafted HTML/JSON used by parser tests; they
  // aren't TypeScript. fixtures/ holds gitignored live captures. Tests
  // (*.test.ts) ARE included so typecheck covers them — earlier they were
  // excluded, which let test-side type errors slip through.
  //
  // The 6 files below import @pdpp/reference-contract, which is out of
  // scope for this move (Move A pins only @pdpp/collector-runtime and
  // @pdpp/connector-protocol) and stays a monorepo-only package until its
  // own repository move lands. Excluded here, not stubbed, to avoid
  // vendoring a large contract package for two functions; reinstate by
  // deleting these exclude entries once @pdpp/reference-contract is
  // available to this repo (git-dependency pin or publish, whichever the
  // reference-contract move settles on).
  "exclude": [
    "node_modules",
    "fixtures",
    "**/__fixtures__",
    "connectors/_conformance/coverage-conformance.test.ts",
    "connectors/github/index.test.ts",
    "connectors/groupme/attachment-detail-coverage.test.ts",
    "connectors/ynab/collect-terminal-coverage.test.ts",
    "connectors/amazon/proof-ingest-records.test.ts",
    "src/collector-bounded-horizon.test.ts",
    "src/collector-scope-contract.test.ts",
    // bin/orchestrate.ts imports ../../../reference-implementation/server/*
    // (a manual dev-loop tool that spins up the monorepo's own reference
    // server) and src/reason-display-messages.test.ts imports
    // ../../../reference-implementation/runtime/recovery-reason-codes.ts.
    // Neither is wired into this package's own scripts/bin entries; both
    // are monorepo-only until reference-implementation has its own move.
    // Reinstate once that path exists in this repo.
    "bin/orchestrate.ts",
    "src/reason-display-messages.test.ts"
  ]
}
