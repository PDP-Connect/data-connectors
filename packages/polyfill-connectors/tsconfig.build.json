{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"declaration": true,
		"declarationMap": true,
		"rewriteRelativeImportExtensions": true
	},
	"include": [
		"src/**/*.ts",
		"connectors/**/*.ts",
		"types/**/*.d.ts",
		"bin/local-device-exporter.ts",
		"bin/scrub-fixtures.ts",
		"bin/test-fixture-capture.ts",
		"scripts/generate-static-secret-registry.ts"
	],
	"exclude": [
		"node_modules",
		"fixtures",
		"**/__fixtures__",
		"**/*.test.ts",
		"**/*.test.child.ts",
		"src/test-fixtures"
	]
}
