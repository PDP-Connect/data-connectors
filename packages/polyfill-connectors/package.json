{
	"name": "@pdpp/polyfill-connectors",
	"version": "0.0.1",
	"private": true,
	"description": "Polyfill connectors for non-PDPP platforms (YNAB, Gmail, Amazon, ChatGPT, USAA).",
	"license": "Apache-2.0",
	"type": "module",
	"engines": {
		"node": ">=24.15.0 <25"
	},
	"exports": {
		"./collectors": "./src/collector-registry.ts",
		"./manifests": "./src/manifest-registry.ts",
		"./reason-display-messages": "./src/reason-display-messages.ts",
		"./browser-handoff": "./src/browser-handoff.ts",
		"./browser-launch": "./src/browser-launch.ts",
		"./browser-surface-policy": "./src/browser-surface-policy.ts",
		"./connector-config-option-kind-registry": "./src/connector-config-option-kind-registry.ts",
		"./connector-conformance-roster": "./src/connector-conformance-roster.ts",
		"./connector-exit": "./src/connector-exit.ts",
		"./connector-options-schema": "./src/connector-options-schema.ts",
		"./connector-runtime": "./src/connector-runtime.ts",
		"./fingerprint-cursor": "./src/fingerprint-cursor.ts",
		"./fixture-capture": "./src/fixture-capture.ts",
		"./local-source-inventory": "./src/local-source-inventory.ts",
		"./profile-lock": "./src/profile-lock.ts",
		"./runtime-environment": "./src/runtime-environment.ts",
		"./session-establish": "./src/session-establish.ts",
		"./shutdown-hook": "./src/shutdown-hook.ts",
		"./streaming-target-registration": "./src/streaming-target-registration.ts",
		"./bounded-zip-archive": "./src/bounded-zip-archive.ts",
		"./capture-redaction": "./src/capture-redaction.ts",
		"./credential-probe": "./src/credential-probe.ts",
		"./credential-probe-transport": "./src/credential-probe-transport.ts",
		"./manual-upload-validation": "./src/manual-upload-validation.ts",
		"./ntfy": "./src/ntfy.ts",
		"./oauth2-generic-provider-auth": "./src/oauth2-generic-provider-auth.ts",
		"./provider-auth-adapter": "./src/provider-auth-adapter.ts",
		"./provider-auth-adapters": "./src/provider-auth-adapters.ts",
		"./static-secret-credential-capture": "./src/static-secret-credential-capture.ts",
		"./static-secret-injection": "./src/static-secret-injection.ts",
		"./static-secret-registry": "./src/generated/static-secret-registry.generated.ts",
		"./connectors/claude_code": "./connectors/claude_code/index.ts",
		"./connectors/codex": "./connectors/codex/index.ts",
		"./connectors/imessage": "./connectors/imessage/index.ts",
		"./connectors/apple_health": "./connectors/apple_health/index.ts",
		"./connectors/google_maps": "./connectors/google_maps/index.ts",
		"./connectors/google_maps_data_portability": "./connectors/google_maps_data_portability/index.ts",
		"./connectors/netflix_export": "./connectors/netflix_export/index.ts",
		"./connectors/whatsapp": "./connectors/whatsapp/index.ts"
	},
	"bin": {
		"pdpp-local-device-exporter": "./bin/local-device-exporter.ts"
	},
	"scripts": {
		"check": "node --import tsx ./scripts/check-biome.ts",
		"check:noAwaitInLoops-conformance": "node --import tsx ./scripts/check-no-await-in-loops-conformance.ts",
		"check:noDirectCredentialEnv": "node --import tsx ./scripts/check-no-direct-credential-env.ts",
		"check:noUnnecessaryConditions-expiry": "node ./scripts/check-no-unnecessary-conditions-expiry.ts",
		"conformance": "tsx scripts/conformance.ts",
		"fix": "ultracite fix",
		"postinstall": "node ./scripts/install-patchright-browser.ts",
		"test": "node scripts/run-tests.mjs",
		"typecheck": "tsc --noEmit",
		"verify": "npm run typecheck && npm run check && npm run check:noAwaitInLoops-conformance && npm run check:noDirectCredentialEnv && npm run check:noUnnecessaryConditions-expiry"
	},
	"dependencies": {
		"@pdpp/collector-runtime": "file:./vendor/pdpp-collector-runtime-0.0.1.tgz",
		"@pdpp/connector-protocol": "file:./vendor/pdpp-connector-protocol-0.0.1.tgz",
		"@pdpp/reference-contract": "file:./vendor/pdpp-reference-contract-0.0.1.tgz",
		"@streamparser/json": "^0.0.25",
		"better-sqlite3": "^13.0.3",
		"dotenv": "^17.4.2",
		"imapflow": "^1.7.1",
		"linkedom": "^0.18.13",
		"ofx-js": "^1.1.1",
		"p-queue": "^9.3.3",
		"p-retry": "^8.0.0",
		"patchright": "1.61.1",
		"pdf-parse": "^2.4.5",
		"playwright": "^1.62.1",
		"saxes": "^6.0.0",
		"ws": "^8.21.3",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@babel/parser": "8.0.4",
		"@biomejs/biome": "2.5.8",
		"@types/better-sqlite3": "^9.6.0",
		"@types/ws": "^8.18.1",
		"tsx": "^4.23.11",
		"ultracite": "7.10.5"
	},
	"overrides": {
		"@pdpp/collector-runtime": {
			"@pdpp/connector-protocol": "file:./vendor/pdpp-connector-protocol-0.0.1.tgz",
			"@pdpp/reference-contract": "file:./vendor/pdpp-reference-contract-0.0.1.tgz"
		}
	}
}
