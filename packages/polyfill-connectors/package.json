	"scripts": {
		"build": "npm run check:connector-index && tsc --project tsconfig.build.json && npm run check:published-entrypoints",
		"check": "node --import tsx ./scripts/check-biome.ts",
		"check:published-entrypoints": "node ./scripts/check-published-entrypoints.mjs",
		"hydrate-vendored-runtime": "node ./scripts/hydrate-vendored-runtime.mjs",
		"check:noAwaitInLoops-conformance": "node --import tsx ./scripts/check-no-await-in-loops-conformance.ts",
		"check:noDirectCredentialEnv": "node --import tsx ./scripts/check-no-direct-credential-env.ts",
		"check:noUnnecessaryConditions-expiry": "node ./scripts/check-no-unnecessary-conditions-expiry.ts",
		"conformance": "tsx scripts/conformance.ts",
		"fix": "ultracite fix",
		"postinstall": "node ./scripts/install-patchright-browser.mjs",
		"test": "node scripts/run-tests.mjs",
		"test:related": "node --import tsx scripts/related-tests/run.ts",
		"typecheck": "tsc --noEmit",
		"verify": "npm run typecheck && npm run check && npm run check:noAwaitInLoops-conformance && npm run check:noDirectCredentialEnv && npm run check:noUnnecessaryConditions-expiry",
		"pack-install-run": "npm run build && node ./scripts/pack-install-run.mjs",
		"prepack": "npm run hydrate-vendored-runtime && npm run build",
		"generate:connector-index": "node ./scripts/generate-connector-implementation-index.mjs",
		"check:connector-index": "node ./scripts/generate-connector-implementation-index.mjs --check"
	},
