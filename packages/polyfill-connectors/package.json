{
	"name": "@pdpp/polyfill-connectors",
	"version": "0.0.1",
	"private": true,
	"description": "Polyfill connectors for non-PDPP platforms (YNAB, Gmail, Amazon, ChatGPT, USAA).",
	"license": "Apache-2.0",
	"type": "module",
	"files": [
		"bin/local-device-exporter.js",
		"connectors/**/*.js",
		"manifests/",
		"scripts/generate-static-secret-registry.js",
		"scripts/install-patchright-browser.mjs",
		"src/**/*.js",
		"vendor/"
	],
	"engines": {
		"node": ">=24.15.0 <25"
	},
	"exports": {
		"./collectors": "./src/collector-registry.js",
		"./manifests": "./src/manifest-registry.js",
		"./reason-display-messages": "./src/reason-display-messages.js",
		"./browser-handoff": "./src/browser-handoff.js",
		"./browser-launch": "./src/browser-launch.js",
		"./browser-surface-policy": "./src/browser-surface-policy.js",
		"./connector-config-option-kind-registry": "./src/connector-config-option-kind-registry.js",
		"./connector-conformance-roster": "./src/connector-conformance-roster.js",
		"./connector-exit": "./src/connector-exit.js",
		"./connector-options-schema": "./src/connector-options-schema.js",
		"./connector-runtime": "./src/connector-runtime.js",
		"./fingerprint-cursor": "./src/fingerprint-cursor.js",
		"./fixture-capture": "./src/fixture-capture.js",
		"./local-source-inventory": "./src/local-source-inventory.js",
		"./profile-lock": "./src/profile-lock.js",
		"./runtime-environment": "./src/runtime-environment.js",
		"./session-establish": "./src/session-establish.js",
		"./shutdown-hook": "./src/shutdown-hook.js",
		"./streaming-target-registration": "./src/streaming-target-registration.js",
		"./bounded-zip-archive": "./src/bounded-zip-archive.js",
		"./capture-redaction": "./src/capture-redaction.js",
		"./credential-probe": "./src/credential-probe.js",
		"./credential-probe-transport": "./src/credential-probe-transport.js",
		"./manual-upload-validation": "./src/manual-upload-validation.js",
		"./ntfy": "./src/ntfy.js",
		"./oauth2-generic-provider-auth": "./src/oauth2-generic-provider-auth.js",
		"./provider-auth-adapter": "./src/provider-auth-adapter.js",
		"./provider-auth-adapters": "./src/provider-auth-adapters.js",
		"./static-secret-credential-capture": "./src/static-secret-credential-capture.js",
		"./static-secret-injection": "./src/static-secret-injection.js",
		"./static-secret-registry": "./src/generated/static-secret-registry.generated.js",
		"./connectors/claude_code": "./connectors/claude_code/index.js",
		"./connectors/codex": "./connectors/codex/index.js",
		"./connectors/imessage": "./connectors/imessage/index.js",
		"./connectors/apple_health": "./connectors/apple_health/index.js",
		"./connectors/google_maps": "./connectors/google_maps/index.js",
		"./connectors/google_maps_data_portability": "./connectors/google_maps_data_portability/index.js",
		"./connectors/netflix_export": "./connectors/netflix_export/index.js",
		"./connectors/whatsapp": "./connectors/whatsapp/index.js"
	},
	"bin": {
		"pdpp-local-device-exporter": "./bin/local-device-exporter.js"
	},
	"scripts": {
		"build": "tsc --project tsconfig.build.json && npm run check:published-entrypoints",
		"check": "node --import tsx ./scripts/check-biome.ts",
		"check:published-entrypoints": "node ./scripts/check-published-entrypoints.mjs",
		"hydrate-vendored-runtime": "node ./scripts/hydrate-vendored-runtime.mjs",
		"check:noAwaitInLoops-conformance": "node --import tsx ./scripts/check-no-await-in-loops-conformance.ts",
		"check:noDirectCredentialEnv": "node --import tsx ./scripts/check-no-direct-credential-env.ts",
		"check:noUnnecessaryConditions-expiry": "node ./scripts/check-no-unnecessary-conditions-expiry.ts",
		"conformance": "tsx scripts/conformance.ts",
		"fix": "ultracite fix",
		"postinstall": "node ./scripts/install-patchright-browser.mjs",
		"test": "node scripts/run-tests.mjs",
		"typecheck": "tsc --noEmit",
		"verify": "npm run typecheck && npm run check && npm run check:noAwaitInLoops-conformance && npm run check:noDirectCredentialEnv && npm run check:noUnnecessaryConditions-expiry",
		"pack-install-run": "npm run build && node ./scripts/pack-install-run.mjs",
		"prepack": "npm run hydrate-vendored-runtime && npm run build"
	},
	"bundledDependencies": [
		"@pdpp/collector-runtime",
		"@pdpp/connector-protocol"
	],
	"dependencies": {
		"@pdpp/collector-runtime": "file:./vendor/pdpp-collector-runtime-0.0.1.tgz",
		"@pdpp/connector-protocol": "file:./vendor/pdpp-connector-protocol-0.0.1.tgz",
		"@streamparser/json": "^0.0.25",
		"better-sqlite3": "^13.0.3",
		"dotenv": "^17.4.2",
		"imapflow": "^1.7.1",
		"linkedom": "^0.18.13",
		"ofx-js": "^1.1.1",
		"p-queue": "^9.3.3",
		"p-retry": "^8.0.0",
		"patchright": "1.61.1",
		"pdf-parse": "^2.4.5",
		"playwright": "^1.62.1",
		"saxes": "^6.0.0",
		"ws": "^8.21.3",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@babel/parser": "8.0.4",
		"@biomejs/biome": "2.5.8",
		"@types/better-sqlite3": "^9.6.0",
		"@types/ws": "^8.18.1",
		"@pdpp/reference-contract": "file:./vendor/pdpp-reference-contract-0.0.1.tgz",
		"tsx": "^4.23.11",
		"typescript": "7.0.2",
		"ultracite": "7.10.5"
	},
	"overrides": {
		"@pdpp/collector-runtime": {
			"@pdpp/connector-protocol": "file:./vendor/pdpp-connector-protocol-0.0.1.tgz",
			"@pdpp/reference-contract": "file:./vendor/pdpp-reference-contract-0.0.1.tgz"
		}
	}
}
