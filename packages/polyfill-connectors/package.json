{
	"name": "@pdpp/polyfill-connectors",
	"version": "0.0.1",
	"private": true,
	"description": "Polyfill connectors for non-PDPP platforms (YNAB, Gmail, Amazon, ChatGPT, USAA).",
	"license": "Apache-2.0",
	"type": "module",
	"files": [
		"scripts/install-patchright-browser.mjs",
		"src/**/*.js",
		"src/**/*.d.ts",
		"src/**/*.d.ts.map",
		"src/manifest-library-metadata.json",
		"vendor/",
		"config/slackdump-api-config.toml"
	],
	"engines": {
		"node": ">=24.15.0 <25"
	},
	"exports": {
		"./reason-display-messages": {
			"types": "./src/reason-display-messages.d.ts",
			"default": "./src/reason-display-messages.js"
		},
		"./browser-handoff": {
			"types": "./src/browser-handoff.d.ts",
			"default": "./src/browser-handoff.js"
		},
		"./browser-launch": {
			"types": "./src/browser-launch.d.ts",
			"default": "./src/browser-launch.js"
		},
		"./browser-surface-policy": {
			"types": "./src/browser-surface-policy.d.ts",
			"default": "./src/browser-surface-policy.js"
		},
		"./connector-config-option-kind-registry": {
			"types": "./src/connector-config-option-kind-registry.d.ts",
			"default": "./src/connector-config-option-kind-registry.js"
		},
		"./connector-conformance-roster": {
			"types": "./src/connector-conformance-roster.d.ts",
			"default": "./src/connector-conformance-roster.js"
		},
		"./connector-exit": {
			"types": "./src/connector-exit.d.ts",
			"default": "./src/connector-exit.js"
		},
		"./connector-options-schema": {
			"types": "./src/connector-options-schema.d.ts",
			"default": "./src/connector-options-schema.js"
		},
		"./connector-runtime": {
			"types": "./src/connector-runtime.d.ts",
			"default": "./src/connector-runtime.js"
		},
		"./fingerprint-cursor": {
			"types": "./src/fingerprint-cursor.d.ts",
			"default": "./src/fingerprint-cursor.js"
		},
		"./fixture-capture": {
			"types": "./src/fixture-capture.d.ts",
			"default": "./src/fixture-capture.js"
		},
		"./local-source-inventory": {
			"types": "./src/local-source-inventory.d.ts",
			"default": "./src/local-source-inventory.js"
		},
		"./profile-lock": {
			"types": "./src/profile-lock.d.ts",
			"default": "./src/profile-lock.js"
		},
		"./runtime-environment": {
			"types": "./src/runtime-environment.d.ts",
			"default": "./src/runtime-environment.js"
		},
		"./session-establish": {
			"types": "./src/session-establish.d.ts",
			"default": "./src/session-establish.js"
		},
		"./shutdown-hook": {
			"types": "./src/shutdown-hook.d.ts",
			"default": "./src/shutdown-hook.js"
		},
		"./streaming-target-registration": {
			"types": "./src/streaming-target-registration.d.ts",
			"default": "./src/streaming-target-registration.js"
		},
		"./bounded-zip-archive": {
			"types": "./src/bounded-zip-archive.d.ts",
			"default": "./src/bounded-zip-archive.js"
		},
		"./capture-redaction": {
			"types": "./src/capture-redaction.d.ts",
			"default": "./src/capture-redaction.js"
		},
		"./credential-probe": {
			"types": "./src/credential-probe.d.ts",
			"default": "./src/credential-probe.js"
		},
		"./credential-probe-transport": {
			"types": "./src/credential-probe-transport.d.ts",
			"default": "./src/credential-probe-transport.js"
		},
		"./ntfy": {
			"types": "./src/ntfy.d.ts",
			"default": "./src/ntfy.js"
		},
		"./oauth2-generic-provider-auth": {
			"types": "./src/oauth2-generic-provider-auth.d.ts",
			"default": "./src/oauth2-generic-provider-auth.js"
		},
		"./provider-auth-adapter": {
			"types": "./src/provider-auth-adapter.d.ts",
			"default": "./src/provider-auth-adapter.js"
		},
		"./static-secret-credential-capture": {
			"types": "./src/static-secret-credential-capture.d.ts",
			"default": "./src/static-secret-credential-capture.js"
		},
		"./static-secret-injection": {
			"types": "./src/static-secret-injection.d.ts",
			"default": "./src/static-secret-injection.js"
		},
		"./static-secret-registry": {
			"types": "./src/generated/static-secret-registry.generated.d.ts",
			"default": "./src/generated/static-secret-registry.generated.js"
		}
	},
	"scripts": {
		"build": "tsc --project tsconfig.build.json && npm run check:published-entrypoints",
		"check": "node --import tsx ./scripts/check-biome.ts",
		"check:published-entrypoints": "node ./scripts/check-published-entrypoints.mjs",
		"check:noAwaitInLoops-conformance": "node --import tsx ./scripts/check-no-await-in-loops-conformance.ts",
		"check:noDirectCredentialEnv": "node --import tsx ./scripts/check-no-direct-credential-env.ts",
		"check:noUnnecessaryConditions-expiry": "node ./scripts/check-no-unnecessary-conditions-expiry.ts",
		"conformance": "tsx scripts/conformance.ts",
		"fix": "ultracite fix",
		"postinstall": "node ./scripts/install-patchright-browser.mjs",
		"test": "npm run test:sandboxed && npm run test:namespaces",
		"test:sandboxed": "../../scripts/test-sandbox/test-sandbox -- node scripts/run-tests.mjs --lane sandboxed",
		"test:namespaces": "../../scripts/test-sandbox/test-sandbox --isolate cgroup --net host -- node scripts/run-tests.mjs --lane namespaces",
		"test:fast": "node --import tsx scripts/related-tests/run.ts --fast",
		"test:related": "node --import tsx scripts/related-tests/run.ts",
		"typecheck": "tsc --noEmit",
		"verify": "npm --prefix ../.. run polyfill-library-metadata:check && npm run typecheck && npm run check && npm run check:noAwaitInLoops-conformance && npm run check:noDirectCredentialEnv && npm run check:noUnnecessaryConditions-expiry",
		"pack-install-run": "../../scripts/test-sandbox/test-sandbox --net host -- node ./scripts/pack-install-run.mjs",
		"prepack": "npm --prefix ../.. run polyfill-library-metadata:check && npm run build"
	},
	"dependencies": {
		"@pdpp/collector-runtime": "2.5.2",
		"@pdpp/connector-protocol": "2.5.2",
		"@streamparser/json": "^0.0.26",
		"better-sqlite3": "^13.0.3",
		"dotenv": "^18.0.9",
		"imapflow": "^2.9.1",
		"linkedom": "^0.18.14",
		"ofx-js": "^1.1.2",
		"p-queue": "^10.0.0",
		"p-retry": "^8.0.1",
		"patchright": "1.64.1",
		"pdf-parse": "^2.4.5",
		"playwright": "^1.64.1",
		"saxes": "^6.0.0",
		"ws": "^8.22.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@babel/parser": "8.0.8",
		"@biomejs/biome": "2.6.2",
		"@types/better-sqlite3": "^9.6.0",
		"@types/ws": "^8.18.2",
		"@pdpp/reference-contract": "file:./vendor/pdpp-reference-contract-0.0.1.tgz",
		"tsx": "^4.23.13",
		"typescript": "7.0.2",
		"ultracite": "8.0.2"
	},
	"overrides": {
		"@pdpp/collector-runtime": {
			"@pdpp/reference-contract": "file:./vendor/pdpp-reference-contract-0.0.1.tgz"
		}
	}
}
